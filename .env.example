# Copy this to .env and fill in real values.

# Google AI Studio API key (Gemini 2.5 Flash + Pro)
GOOGLE_API_KEY=

# Optional: Google Maps Platform key (Geocoding + Places + Distance Matrix).
# Leave empty to use mock implementations.
GOOGLE_MAPS_KEY=

# Supabase — single source of truth for all persistent data
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# Demo behavior
# DEMO_MODE=true caches 5 canonical Gemini responses to avoid quota issues during the demo.
DEMO_MODE=false

# 1 real-second = N simulated-minutes. Set to 60 for live no-show demo, 1 for production.
DEMO_TIME_SCALE=1

# Artificial delay (ms) between trace events in demo mode. 0 = no delay.
DEMO_TRACE_PACE_MS=0

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
